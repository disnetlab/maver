cff-version: 1.2.0
title: "MAVER: A Multi-Agent Framework for Verification and Experience-Informed Recovery of Microservices"
message: "If you use this software, please cite it using these metadata."
type: software
authors:
  - family-names: Guo
    given-names: Yifeng
    affiliation: The University of Melbourne
  - family-names: Setiawan
    given-names: Stefanus Stanley Yoga
    affiliation: The University of Melbourne
