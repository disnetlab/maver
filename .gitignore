# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Local runtime state (see settings.workspace.dir)
.local-workspace/
*.db
*.sqlite3

# Environment
.env
.env.local

# Editors and OS
.DS_Store
.idea/
.vscode/

# Local-only deployment helpers, machine specific
update-vm.sh

# Rebuild working state: deep-read notes, design specs in progress, workflow
# scripts. Deleted once the rebuild is done; never part of the published artifact.
refactor/

# Compose runtime state: per host, and one of them holds credentials.
# See deploy/docker/kira.env.example.
deploy/docker/kira.env
deploy/docker/kubeconfig

# Agent worktrees. Untracked would still be linted, and a check on main must not
# depend on what another worktree is mid-edit on.
.claude/
