# Copy to maver.env beside the compose file and fill in. Every name here is one the
# settings layer recognises; a MAVER_-prefixed name it does not recognise is a startup
# failure rather than a silent default, so a typo here stops the container.

# Which model, and where it is served. The profile carries the whole sampling set; only
# the address changes per deployment.
MAVER_MODEL__PROFILE=qwen3.6-35b-a3b
MAVER_MODEL__ENDPOINT_OVERRIDE=http://vllm.internal:8000/v1
MAVER_MODEL__API_KEY=EMPTY

# Who authorises a cluster write. `prompt` holds each write until a person decides it
# through the approval API; `auto` is for an unattended evaluation and lands in the run's
# configuration snapshot, so results say what authority produced them. `kubectl exec`
# still requires a person under automatic write approval because it cannot be proven
# read-only. Keep this boundary in production: arbitrary exec can mutate application
# state even without permission to patch or delete Kubernetes objects.
MAVER_AUTHORITY__MODE=prompt
MAVER_AUTHORITY__KUBECTL_EXEC_REQUIRES_APPROVAL=true

# Telemetry backends. An unset endpoint withdraws the tools that would have used it,
# which is a description of the deployment rather than an error.
MAVER_TRANSPORT__PROMETHEUS_URL=http://prometheus.internal:9090
MAVER_TRANSPORT__LOKI_URL=http://loki.internal:3100
MAVER_TRANSPORT__JAEGER_URL=http://jaeger.internal:16686

# Memory and the offline pass that fills it.
MAVER_MEMORY__ENABLED=true
MAVER_MEMORY__LEARNING_ENABLED=true

# HTTP intake is enabled by default. Kafka additionally requires the kafka extra.
# Read and operator API routes remain available when HTTP submission is disabled.
MAVER_INTAKE__HTTP_ENABLED=true
MAVER_INTAKE__KAFKA__ENABLED=false
# MAVER_INTAKE__KAFKA__BOOTSTRAP_SERVERS=broker:9092
# MAVER_INTAKE__KAFKA__TOPIC=alerts
# MAVER_INTAKE__KAFKA__GROUP_ID=maver

# Optional stage-boundary recovery. Interrupted writes require operator reconciliation.
# Keep the workspace and session database persistent across process restarts.
MAVER_SERVER__RESUME_INTERRUPTED_INCIDENTS=false

# Optional recovery verification. The hand-back cap is a subset of the shared
# remediation budget: 0 prohibits Verify returns, 1 permits one. Omit to inherit
# MAVER_PIPELINE__REMEDIATION_RETRIES (default 2). Execution replans and inconclusive
# rechecks do not spend this subset. Per-pipeline YAML can tighten this ceiling.
# MAVER_VERIFY__ENABLED=true
# MAVER_VERIFY__HANDBACK_RETRIES=1

# Tracing. Unset disables export without disabling instrumentation.
# MAVER_OBSERVABILITY__OTLP_ENDPOINT=alloy.internal:4317
MAVER_OBSERVABILITY__LOG_LEVEL=INFO

# Optional named agent and pipeline configuration. Register custom Python behaviour
# in src/maver/custom.py; mount the YAML at this path in the container.
# MAVER_CUSTOMISATION=/app/configs/local.yaml
