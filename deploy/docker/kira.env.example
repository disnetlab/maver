# Copy to kira.env beside the compose file and fill in. Every name here is one the
# settings layer recognises; a KIRA_-prefixed name it does not recognise is a startup
# failure rather than a silent default, so a typo here stops the container.

# Which model, and where it is served. The profile carries the whole sampling set; only
# the address changes per deployment.
KIRA_MODEL__PROFILE=qwen3.6-35b-a3b
KIRA_MODEL__ENDPOINT_OVERRIDE=http://vllm.internal:8000/v1
KIRA_MODEL__API_KEY=EMPTY

# Who authorises a cluster write. `prompt` holds each write until a person decides it
# through the approval API; `auto` is for an unattended evaluation and lands in the run's
# configuration snapshot, so results say what authority produced them.
KIRA_AUTHORITY__MODE=prompt

# Telemetry backends. An unset endpoint withdraws the tools that would have used it,
# which is a description of the deployment rather than an error.
KIRA_TRANSPORT__PROMETHEUS_URL=http://prometheus.internal:9090
KIRA_TRANSPORT__LOKI_URL=http://loki.internal:3100
KIRA_TRANSPORT__JAEGER_URL=http://jaeger.internal:16686

# Memory and the offline pass that fills it.
KIRA_MEMORY__ENABLED=true
KIRA_MEMORY__LEARNING_ENABLED=true

# Tracing. Unset disables export without disabling instrumentation.
# KIRA_OBSERVABILITY__OTLP_ENDPOINT=alloy.internal:4317
KIRA_OBSERVABILITY__LOG_LEVEL=INFO
